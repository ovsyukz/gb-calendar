{
  "name": "gb-calendar",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "Tournament calendar for Gracie Barra Deerfield",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node scripts/build-html.js",
    "dev": "npm run build && node --env-file-if-exists=.env scripts/dev-server.js",
    "migrate": "node --env-file-if-exists=.env scripts/migrate.js",
    "admin:add": "node --env-file-if-exists=.env scripts/create-admin.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@netlify/neon": "^0.1.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.4",
    "eslint": "^9.15.0",
    "globals": "^15.12.0",
    "prettier": "^3.4.0",
    "vitest": "^4.1.10"
  }
}
