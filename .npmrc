# Refuse to install on a Node version other than the one in .nvmrc, which is
# also the one CI and Netlify build with.
#
# This is not tidiness. npm 10 (bundled with Node 22) and npm 11 resolve
# optional peer dependencies differently: waddler, via @netlify/database,
# declares @electric-sql/pglite ^0.2.17 as an optional peer, which this
# project's ^0.5.4 devDependency does not satisfy. npm 10 installs it nested,
# npm 11 skips it. Running `npm install` on the wrong version silently
# rewrites package-lock.json, and `npm ci` then fails in CI with
# "Missing: @electric-sql/pglite@0.2.17 from lock file".
#
# `npm run verify` cannot catch that — it never runs `npm ci`.
engine-strict=true