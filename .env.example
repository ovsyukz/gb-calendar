# Copy to .env for local development. Real values live in 1Password, and are
# set as environment variables in the Netlify UI for production.

# Production admin accounts live in the database — see `npm run admin:add`.
# Passwords are stored as one-way scrypt hashes and cannot be read back.
#
# These seed a local admin on a fresh database so you can log in straight
# away. Applied only when the admins table is empty, and only against the
# local database — never against Netlify DB.
LOCAL_ADMIN_NAME=Local Admin
LOCAL_ADMIN_EMAIL=admin@local
LOCAL_ADMIN_PASSWORD=localdev123

# Random 32+ byte string used to sign admin session cookies.
# Generate one with:  node -e "console.log(crypto.randomBytes(32).toString('hex'))"
SESSION_SECRET=change-me-locally

# Provided automatically by Netlify DB in deployed environments.
# For local dev, copy the connection string from the Netlify dashboard.
NETLIFY_DATABASE_URL=postgres://user:pass@host/db?sslmode=require
